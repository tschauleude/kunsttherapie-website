NODE_ENV=production
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Admin-Zugang (nach Deploy: Martina kann sich unter /admin anmelden)
ADMIN_USERNAME=martina
ADMIN_PASSWORD=mindestens-8-zeichen-hier
ADMIN_EMAIL=info@kunsttherapie-pb.de

# Optional: einmalige Ersteinrichtung über /admin → „Erstes Admin-Konto anlegen“
# SETUP_TOKEN=langer-zufaelliger-string

DATABASE_PATH=./database.sqlite
CORS_ORIGIN=https://kunsttherapie.mkmpb.de,https://mkmpb.de
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./public/uploads

# Terminbuchung (optional anpassen)
BOOKING_SLOT_MINUTES=90
BOOKING_MIN_ADVANCE_HOURS=24
BOOKING_TIMEZONE=Europe/Berlin
# Optional: eigene Zeiten (Wochentag 0=So … 2=Di, 4=Do)
# BOOKING_SCHEDULE={"2":{"start":"09:00","end":"12:30","label":"Dienstag Vormittag"},"4":{"start":"17:00","end":"20:00","label":"Donnerstag Abend"}}

# Google Kalender (einmalig verbinden über Admin → Termine → Mit Google verbinden)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://kunsttherapie.mkmpb.de/api/admin/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
