{
  "name": "kunsttherapie-cms",
  "version": "1.0.0",
  "description": "CMS für Kunsttherapie Paderborn - Backend für News, Events, und Admin-Panel",
  "main": "server.js",
  "scripts": {
    "prestart": "node scripts/build-frontend.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup-admin": "node scripts/setup-admin.js",
    "sync-admin": "cp admin.html public/admin.html",
    "sync-chrome": "node scripts/build-chrome.js && node scripts/apply-chrome.js",
    "patch-meta": "node scripts/patch-head-meta.js",
    "upgrade-seo": "node scripts/upgrade-seo.js",
    "validate-i18n": "node scripts/validate-i18n.js",
    "build-frontend": "node scripts/build-frontend.js",
    "qa": "node scripts/validate-i18n.js && node --check assets/js/*.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.17.3",
    "googleapis": "^140.0.1",
    "helmet": "^8.2.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "sharp": "^0.34.5",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  }
}
